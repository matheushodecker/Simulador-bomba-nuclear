# Copie para ".env.local" e preencha UMA das chaves para ativar as cidades fotorrealistas
# do modo cinema já no carregamento (também é possível colar a chave no próprio app).
# Nunca faça commit do arquivo com a chave.

# Google Maps Platform → ative a "Map Tiles API" e gere uma chave
VITE_GOOGLE_TILES_KEY=

# ou: token do Cesium ion (com o recurso "Google Photorealistic 3D Tiles", ID 2275207)
VITE_CESIUM_ION_TOKEN=
